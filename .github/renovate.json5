{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // ⚠ THIS FILE DOES NOTHING ON ITS OWN.
  // Renovate is a GitHub App, and config without the App installed is a file that looks
  // like automation and opens zero pull requests — silently, forever. Install it on this
  // repo at https://github.com/apps/renovate, then treat "when did the bot last open a
  // PR?" as a health signal. A quiet Renovate and a working Renovate look identical.

  extends: [
    'config:recommended',
    ':dependencyDashboard', // one issue listing everything pending, including what it skipped
    ':semanticCommits',
  ],

  timezone: 'Asia/Jerusalem',

  // A starter repo rots by drifting: six months of unattended updates and someone clones
  // a config that no longer applies. But a wall of PRs is its own kind of dead, so this is
  // tuned for "few, and worth reading".
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // Let a release sit for three days before proposing it. Enough for the ".0 was broken,
  // here is .1" cycle to play out somewhere other than your cluster.
  minimumReleaseAge: '3 days',

  // The Argo CD `Application` manifests. NOT the default path for this manager — its
  // default only matches `argocd/**`, so without this every chart pin here would be
  // invisible and the file would still look correctly configured.
  // examples/ is a TEMPLATE people copy into their own repo, and the default
  // github-actions manager only scans .github/workflows — so without this the example
  // silently rots and hands newcomers a workflow that is majors behind. Found exactly
  // that: every action in it was one major behind on the day it was written.
  'github-actions': {
    managerFilePatterns: [
      '/^\\.github/workflows/.+\\.ya?ml$/',
      '/^examples/.+\\.ya?ml$/',
    ],
  },

  // Both directories. kubernetes/optional holds apps that are not deployed by default —
  // the tunnel connector, Traefik, External Secrets — and "not deployed yet" is exactly how
  // a pin gets forgotten until someone copies a two-year-old chart into their cluster.
  argocd: {
    managerFilePatterns: ['/kubernetes/(applications|optional)/.+\\.ya?ml$/'],
  },

  // Plain Kubernetes manifests — the Deployments/StatefulSets in kubernetes/manifests.
  //
  // ⚠ The kubernetes manager's default is `managerFilePatterns: []`, i.e. an EMPTY list:
  // it matches no file at all until you scope it. Same class of bug as the argocd path
  // above, one level deeper — the config looks wired, and no image tag is ever found.
  kubernetes: {
    managerFilePatterns: ['/kubernetes/manifests/.+\\.ya?ml$/'],
  },

  // Image tags and versions that live inside strings no manager understands: the Helm
  // values block embedded in an Argo Application, and Terraform variable defaults. Both
  // are marked with a `# renovate:` comment at the line above.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/kubernetes/(applications|optional)/.+\\.ya?ml$/',
        '/terraform/.+\\.tf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)\\s+[a-zA-Z_]+\\s*[:=]\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
      // Tags here are v-prefixed release names, which is not always strict semver.
      versioningTemplate: 'loose',
    },
  ],

  packageRules: [
    {
      description: 'Group the GitHub Actions bumps — they are noise individually.',
      matchManagers: ['github-actions'],
      groupName: 'github actions',
    },
    {
      // LifeOS is an app we do not fork: upstream publishes the image, so a tag bump in
      // kubernetes/manifests/lifeos/app.yaml IS the entire upgrade. Automerging is the
      // equivalent of daftari's build-and-commit pipeline.
      //
      // '0 days' is deliberate and overrides the repo-wide 3-day default: the goal is to
      // track upstream as soon as Renovate sees the release. Removing this line instead of
      // setting it would silently fall back to 3 days.
      //
      // Accepted risk: the app runs MySQL schema migrations on boot with no rollback path,
      // so a release that migrates the database cannot be undone by reverting the tag. The
      // database dump is the rollback plan, not the previous image.
      description: 'LifeOS: upstream release bumps the image tag, and that bump is the deploy',
      matchPackageNames: ['ghcr.io/edrisranjbar/lifeos'],
      automerge: true,
      // NOT platformAutomerge: this repo has GitHub's "Allow auto-merge" switched off and
      // `main` is unprotected, so asking GitHub to own the merge fails outright. Renovate
      // merges the PR itself once the branch is green — `ignoreTests` is false by default,
      // so a failing `validate` run still blocks it.
      minimumReleaseAge: '0 days',
    },
    {
      description: 'Kubernetes chart majors are not routine: they move resource shapes and can strand data. Read the upgrade notes.',
      matchManagers: ['argocd', 'helm-values'],
      matchUpdateTypes: ['major'],
      addLabels: ['read-the-release-notes'],
      minimumReleaseAge: '14 days',
    },
    {
      description: 'Terraform provider majors likewise — the OCI provider is at 8.x after 200+ releases, and a major will move resource shapes under you.',
      matchManagers: ['terraform'],
      matchUpdateTypes: ['major'],
      addLabels: ['read-the-release-notes'],
      minimumReleaseAge: '14 days',
    },
    {
      description: 'Argo CD is installed at FIRST BOOT ONLY, so bumping this variable does not upgrade a running cluster — it changes what the NEXT rebuild installs. Labelled so the PR does not read as a live upgrade.',
      matchDepNames: ['argoproj/argo-cd'],
      addLabels: ['affects-next-rebuild-only'],
    },
  ],
}
